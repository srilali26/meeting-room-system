# ==============================================================================
# Meeting Room Booking — Self-Hosted Production Environment Configuration
# Windows Server Internal Network: http://192.168.50.143
# ==============================================================================

# Application Base URL (Used for all permanent QR codes, email cancel links and displays)
# Note: Single setting. Must be the exact IP/URL reachable by mobile phones & media players.
APP_URL=http://192.168.50.143
NEXT_PUBLIC_APP_URL=http://192.168.50.143

# Server Port (80 for production internal Windows Server, 3000 for local test)
PORT=80

# Timezone (All timestamps stored in UTC, converted to Dubai for display)
TIMEZONE=Asia/Dubai
NEXT_PUBLIC_TIMEZONE=Asia/Dubai

# Self-Hosted PostgreSQL Database Connection
# When PostgreSQL is running, the app connects to it and enables LISTEN/NOTIFY.
# When running standalone/test without PostgreSQL, the built-in local engine seamlessly activates.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_rooms

# Security & Session Settings
# Cookie secure flag: set to false for plain HTTP on internal IP, set to true if SSL/HTTPS is enabled
COOKIE_SECURE=false
SESSION_SECRET=super_secret_session_encryption_key_change_me_in_production_32char

# Optional SMTP Settings (Off by default. When empty, emails are logged to audit file)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Meeting Room Booking <no-reply@192.168.50.143>"
